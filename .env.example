# Copy to .env and fill in your values, or run `bash install/docker-install.sh`,
# which writes this file for you.

# The map key from the mapserver you created on ollebo.com. It decides which
# Space your maps appear in. You can also paste it on the Settings page later;
# a key saved there takes priority.
OLLEBO_KEY=

# Local folder name for your maps inside the tile store. It does not need to
# match anything on ollebo.com.
OLLEBO_SPACE_ID=local

# The address browsers use to fetch tiles. It must be reachable by everyone who
# views your maps on ollebo.com, e.g. https://tiles.example.com.
TERRACOTTA_PUBLIC_URL=http://localhost:5001

# ollebo.com API. Where this server checks its key and registers maps.
API=https://www.ollebo.com/api

# Tile store. The defaults match the container.
TERRACOTTA_DB_PATH=/data/db/terracotta.sqlite
TERRACOTTA_PROVIDER=sqlite
